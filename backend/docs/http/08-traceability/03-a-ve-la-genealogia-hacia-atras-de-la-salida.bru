meta {
  name: A consulta hacia atrás la salida (que ahora es de B): lo suyo completo, lo de B solo compartido
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/traceability/batches/{{outputId}}/ancestors
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorToken}}
}

assert {
  res.status: eq 200
}

tests {
  const node = (id) => res.body.nodes.find((n) => n.id === id);
  const hidden = (n, fields) => fields.filter((f) => Object.prototype.hasOwnProperty.call(n, f));
  const BATCH_PRIVATE = ["supplierName", "origin", "quantityKg", "composition", "receptionCharacteristics", "qualityHold"];
  const TRANSFORMATION_PRIVATE = ["machineName", "machineType", "shrinkageKg", "wasteKg", "wasteReason"];

  test("la salida, la transformación, el hijo de 40 kg y el lote madre; completa y sin cortar", function () {
      expect(res.body.direction).to.equal("ANCESTORS");
      expect(res.body.nodes.length).to.equal(4);
      expect(res.body.complete).to.equal(true);
      expect(res.body.truncated).to.equal(false);
      expect(res.body.edges.length).to.equal(3);
  });
  test("los niveles: la salida 0, la transformación y el hijo de 40 kg a un salto, el lote madre a dos", function () {
      expect(node(bru.getVar("outputId")).level).to.equal(0);
      expect(node(bru.getVar("child40Id")).level).to.equal(-1);
      expect(node(bru.getVar("lotId")).level).to.equal(-2);
  });
  test("lo de A se ve completo", function () {
      const lot = node(bru.getVar("lotId"));
      expect(lot.access).to.equal("OWN");
      expect(lot.supplierName).to.equal("Textiles del Norte");
      expect(lot.origin).to.equal("Piura");
      expect(lot.quantityKg).to.equal(100);
      expect(lot.composition.length).to.equal(2);
      expect(node(bru.getVar("transformationId")).wasteReason).to.equal("Orillo y recortes");
  });
  test("la salida es de B: A ve solo lo siempre compartido (y el nombre de B)", function () {
      const out = node(bru.getVar("outputId"));
      expect(out.access).to.equal("SHARED");
      expect(out.companyId).to.equal(bru.getVar("companyBId"));
      expect(out.businessName).to.be.a("string").and.not.equal(out.companyId);
      expect(node(bru.getVar("lotId")).businessName).to.be.a("string").and.not.equal(node(bru.getVar("lotId")).companyId);
      expect(out.traceabilityId).to.be.a("string");
      expect(hidden(out, BATCH_PRIVATE)).to.deep.equal([]);
  });
  test("la respuesta no es cacheable", function () { expect(res.getHeader("cache-control")).to.equal("no-store"); });
}

script:post-response {
  bru.setVar("nameOfA", res.body.nodes.find((n) => n.id === bru.getVar("lotId")).businessName);
  bru.setVar("nameOfB", res.body.nodes.find((n) => n.id === bru.getVar("outputId")).businessName);
}

docs {
  Privacidad B2B por empresa (ADR-006): el filtro se aplica en el servidor. Los campos que no se ven no salen ni como null.
}
