meta {
  name: A lee el código QR de su lote (para que B lo busque)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/batches/{{lotId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("el lote tiene un código QR", function () { expect(bru.getVar("lotQr")).to.be.a("string"); });
}

script:post-response {
  bru.setVar("lotQr", res.body.qrCode);
  bru.setVar("lotPrefix", bru.getVar("lotTraceabilityId").slice(0, 6));
}
