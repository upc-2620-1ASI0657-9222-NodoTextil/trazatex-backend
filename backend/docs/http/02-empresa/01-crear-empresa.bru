meta {
  name: Crear la empresa
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/companies
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "ruc": "{{ruc}}",
    "businessName": "{{businessName}}",
    "activities": [
      "WEAVING",
      "DYEING"
    ],
    "adminEmail": "{{adminEmail}}"
  }
}

assert {
  res.status: eq 201
  res.body.company.status: eq ACTIVE
}

script:post-response {
  bru.setVar("companyId", res.body.company.id);
  bru.setVar("companyKey", req.getHeader("Idempotency-Key"));
}

docs {
  Consulta el RUC en Chequea.pe (GASTA UNA CONSULTA de tu cuota, salvo que ese RUC esté en la caché de 24 h de organization-access).
  Crea la empresa y la invitación de su primer administrador (`InvitationCreated`, rol COMPANY_ADMIN).
}
