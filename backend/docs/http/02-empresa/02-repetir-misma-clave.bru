meta {
  name: Repetir con la misma Idempotency-Key
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/companies
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{companyKey}}
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "ruc": "{{ruc}}",
    "businessName": "{{businessName}}",
    "activities": [
      "WEAVING",
      "DYEING"
    ],
    "adminEmail": "{{adminEmail}}"
  }
}

assert {
  res.status: eq 201
  res.body.company.id: eq {{companyId}}
}

docs {
  La misma clave y el mismo cuerpo devuelven la misma respuesta sin crear una segunda empresa ni consultar de nuevo a Chequea.pe (ADR-010).
}
