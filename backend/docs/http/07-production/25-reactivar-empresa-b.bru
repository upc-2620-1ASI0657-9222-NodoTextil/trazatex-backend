meta {
  name: El Dueño reactiva la empresa B
  type: http
  seq: 25
}

patch {
  url: {{baseUrl}}/api/companies/{{companyBId}}/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  { "status": "ACTIVE" }
}

assert {
  res.status: eq 200
  res.body.status: eq ACTIVE
}

script:post-response {
  await bru.sleep(3000);
}

docs {
  Deja la colección repetible.
}
