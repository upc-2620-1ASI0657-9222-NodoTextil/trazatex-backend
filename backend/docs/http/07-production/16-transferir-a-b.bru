meta {
  name: Transferir la salida (35 kg) y el hijo de 60 kg a la empresa B
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/transfers
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{operatorToken}}
}

body:json {
  {
    "targetCompanyId": "{{companyBId}}",
    "batchIds": ["{{outputId}}", "{{child60Id}}"],
    "quantitiesKg": { "{{outputId}}": 35, "{{child60Id}}": 60 }
  }
}

assert {
  res.status: eq 201
  res.body.status: eq PENDING
}

script:post-response {
  bru.setVar("transferId", res.body.id);
}

docs {
  Los lotes pasan a IN_TRANSFER. Evento `TransferInitiated` en `production.transfer` (clave = id de la transferencia).
}
