meta {
  name: Adjuntar una evidencia (queda PENDING sin Cloudinary)
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/batches/{{lotId}}/evidence
  body: multipartForm
  auth: bearer
}

headers {
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{operatorToken}}
}

body:multipart-form {
  files: @file(07-production/files/foto.jpg)
}

assert {
  res.status: eq 201
  res.body.items[0].status: eq PENDING
}

docs {
  Con Production sin `CLOUDINARY_URL` la evidencia se acepta (201) y queda PENDING en `evidence_upload_queue` hasta que haya almacén.
  El formato se valida por los primeros bytes del archivo (no por su nombre ni su Content-Type). Máximo 5 archivos de 10 MB.
}
