meta {
  name: El administrador registra una maquinaria
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/machines
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "internalCode": "TJ-{{$randomInt}}",
    "name": "Telar Jacquard",
    "type": "Tejeduría"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq ACTIVE
}

script:post-response {
  bru.setVar("machineId", res.body.id);
}

