meta {
  name: Iniciar una transformación (tintura) con el hijo de 40 kg
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/transformations
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{operatorToken}}
}

body:json {
  {
    "type": "DYEING",
    "machineId": "{{machineId}}",
    "batchIds": ["{{child40Id}}"]
  }
}

assert {
  res.status: eq 201
  res.body.status: eq IN_PROGRESS
}

script:post-response {
  bru.setVar("transformationId", res.body.id);
}

docs {
  El hijo pasa a IN_TRANSFORMATION.
}
