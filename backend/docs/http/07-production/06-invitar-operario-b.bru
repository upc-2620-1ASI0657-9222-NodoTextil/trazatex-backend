meta {
  name: El administrador invita al operario
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/invitations/operators
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{adminBToken}}
}

body:json {
  {
    "firstName": "Mario",
    "lastName": "Vega",
    "email": "{{operatorBEmail}}",
    "position": "Tintorero"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq PENDING
}
