meta {
  name: Aceptar la invitación (pública)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/invitations/{{operatorBInvitationToken}}/accept
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Mario",
    "lastName": "Vega",
    "password": "{{operatorBPassword}}",
    "passwordConfirmation": "{{operatorBPassword}}"
  }
}

assert {
  res.status: eq 201
  res.body.role: eq OPERATOR
}
