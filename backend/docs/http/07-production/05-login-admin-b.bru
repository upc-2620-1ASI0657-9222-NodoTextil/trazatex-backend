meta {
  name: Login
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminBEmail}}",
    "password": "{{adminBPassword}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("adminBToken", res.body.token);
}
