meta {
  name: Aceptar la invitación (pública)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/invitations/{{operatorInvitationToken}}/accept
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Luis",
    "lastName": "Rojas",
    "password": "{{operatorPassword}}",
    "passwordConfirmation": "{{operatorPassword}}"
  }
}

assert {
  res.status: eq 201
  res.body.role: eq OPERATOR
}
