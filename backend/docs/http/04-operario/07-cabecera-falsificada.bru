meta {
  name: Falsifica X-User-Role=LICENSE_OWNER → el Gateway la pisa
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/license
  body: none
  auth: bearer
}

headers {
  X-User-Role: LICENSE_OWNER
  X-User-Id: {{ownerId}}
}

auth:bearer {
  token: {{operatorToken}}
}

assert {
  res.status: eq 403
}

docs {
  Con la cabecera falsa el servicio vería al Dueño y respondería 200. Responde 403: el rol es el del token (OPERATOR).
}
