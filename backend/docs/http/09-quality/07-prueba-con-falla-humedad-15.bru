meta {
  name: Prueba con falla (humedad 15 %)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/quality/controls/{{q1ControlId}}/tests
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "criterionName": "Humedad",
    "expectedValue": "8",
    "obtainedValue": "15",
    "unit": "%",
    "testResult": "FAILED",
    "remarks": "muy húmeda"
  }
}

assert {
  res.status: eq 201
}
