meta {
  name: Operario A registra un lote de 30 kg (Tela cruda Q2)
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/api/batches
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{operatorToken}}
}

body:json {
  {
    "name": "Tela cruda Q2",
    "materialType": "Tela",
    "composition": [{ "name": "Algodón", "percentage": 100 }],
    "quantityKg": 30,
    "origin": "Piura",
    "supplierName": "Textiles del Norte",
    "receptionCharacteristics": "Tela cruda"
  }
}

assert {
  res.status: eq 201
  res.body.phase: eq AVAILABLE
}

script:post-response {
  bru.setVar("q2Id", res.body.id);
  bru.setVar("q2TraceabilityId", res.body.traceabilityId);
}

docs {
  Segundo lote, para el descarte.
}
