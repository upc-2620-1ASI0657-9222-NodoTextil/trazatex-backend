meta {
  name: Operario A registra un lote de 50 kg (Tela cruda Q1)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/batches
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{operatorToken}}
}

body:json {
  {
    "name": "Tela cruda Q1",
    "materialType": "Tela",
    "composition": [{ "name": "Algodón", "percentage": 100 }],
    "quantityKg": 50,
    "origin": "Piura",
    "supplierName": "Textiles del Norte",
    "receptionCharacteristics": "Tela cruda"
  }
}

assert {
  res.status: eq 201
  res.body.phase: eq AVAILABLE
}

script:post-response {
  bru.setVar("q1Id", res.body.id);
  bru.setVar("q1TraceabilityId", res.body.traceabilityId);
}

docs {
  Lote AVAILABLE y NOT_REVIEWED de la empresa A; la proyección de Quality lo recibe por `BatchRegistered`.
}
