meta {
  name: Adjuntar una foto a la falla
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/quality/evidence
  body: multipartForm
  auth: bearer
}

headers {
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{adminToken}}
}

body:multipart-form {
  failureId: {{q1FailureId}}
  files: @file(07-production/files/foto.jpg)
}

assert {
  res.status: eq 201
  res.body.items[0].ownerType: eq FAILURE
}
