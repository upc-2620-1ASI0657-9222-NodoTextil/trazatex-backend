meta {
  name: Una notificación que no existe: 404, igual que la ajena
  type: http
  seq: 6
}

PATCH {
  url: {{baseUrl}}/api/notifications/00000000-0000-0000-0000-000000000000/read
  body: none
  auth: bearer
}

headers {
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{adminBToken}}
}

assert {
  res.status: eq 404
  res.body.code: eq NOTIFICATION_NOT_FOUND
}
