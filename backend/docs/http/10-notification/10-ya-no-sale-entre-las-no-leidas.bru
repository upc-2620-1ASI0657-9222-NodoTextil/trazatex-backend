meta {
  name: Ya no sale entre las no leídas
  type: http
  seq: 10
}

GET {
  url: {{baseUrl}}/api/notifications?unread=true&type=TRANSFER_RECEIVED&size=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminBToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("la leída ya no está entre las no leídas", function () {
    const found = (res.body.items || []).find(n => n.data && n.data.transferId === bru.getVar("transferId"));
    expect(found).to.equal(undefined);
  });
}
