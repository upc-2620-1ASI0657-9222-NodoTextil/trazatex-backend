meta {
  name: B no recibe el aviso de aceptación (es de la empresa de origen)
  type: http
  seq: 13
}

GET {
  url: {{baseUrl}}/api/notifications?type=TRANSFER_ACCEPTED&size=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminBToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("B no ve TRANSFER_ACCEPTED de su propia aceptación", function () {
    const found = (res.body.items || []).find(n => n.data && n.data.transferId === bru.getVar("transferId"));
    expect(found).to.equal(undefined);
  });
}
