meta {
  name: Marcarla otra vez no cambia nada (idempotente)
  type: http
  seq: 9
}

PATCH {
  url: {{baseUrl}}/api/notifications/{{notifReceivedId}}/read
  body: none
  auth: bearer
}

headers {
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{adminBToken}}
}

assert {
  res.status: eq 200
  res.body.read: eq true
}
