# =============================================================================
# TrazaTex — variables de entorno
#
# Uso:   cp .env.example .env   y completa los valores vacíos.
# El .env real NUNCA se comparte (está en .gitignore). Aquí no hay valores reales:
# todo lo sensible va vacío; lo pre-rellenado son endpoints locales sin secretos.
# Contraseñas locales de ejemplo:   openssl rand -hex 16
#
# Lo lee `docker compose` (sección 1) y lo exportas al correr cada servicio desde la Mac
# (por ejemplo `set -a; . ./.env; set +a`). Las variables marcadas [SIGUIENTE SPRINT]
# aún no las usa ningún servicio implementado.
#
# Nombres por servicio: la convención (docs/conventions.md) es que cada servicio lee
# DB_URL, DB_USER y DB_PASSWORD. Como un solo .env sirve a varios servicios, aquí llevan
# prefijo (ORGACCESS_DB_URL, PRODUCTION_DB_USER...) y el perfil `local` de cada servicio
# los toma de su prefijo cuando DB_* no está definida.
# =============================================================================


# -----------------------------------------------------------------------------
# 0. Comunes a todos los servicios Spring
# -----------------------------------------------------------------------------

# Perfil de Spring: `local` (docker compose, corriendo desde la Mac) o `azure`.
SPRING_PROFILES_ACTIVE=local

# Brokers de Kafka. Desde la Mac: localhost:9092 (listener EXTERNAL).
# Desde un contenedor de la red de compose sería kafka:29092 (listener INTERNAL).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092


# -----------------------------------------------------------------------------
# 1. Infraestructura local (docker compose)
# -----------------------------------------------------------------------------

# Superusuario de PostgreSQL. Solo para administración; ningún servicio lo usa.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Neo4j (edición community). El usuario administrador se llama siempre `neo4j`.
NEO4J_USER=neo4j
# Contraseña de Neo4j. Mínimo 8 caracteres. También es la que usa traceability (sección 5).
NEO4J_PASSWORD=

# Las credenciales de cada base de PostgreSQL (un usuario por servicio, sin acceso a las demás
# bases) están en las secciones de cada servicio: infra/postgres/init.sh las usa al crear el
# volumen. Si las cambias después, hay que recrear el volumen (`docker compose down -v`).


# -----------------------------------------------------------------------------
# 2. api-gateway (puerto 8080)
# -----------------------------------------------------------------------------

# URL del JWKS de organization-access: de ahí el Gateway toma las claves públicas (las guarda en
# caché) para validar los JWT RS256.
JWKS_URI=http://localhost:8081/.well-known/jwks.json

# URL base de organization-access, a donde el Gateway enruta /api/auth, /api/companies, etc.
# (Production y Traceability tendrán la suya cuando existan). Desde la Mac: el puerto 8081.
ORGANIZATION_ACCESS_URL=http://localhost:8081
# Detrás del ingress de Azure (NO en local): el Gateway limita por IP (login, invitaciones, peticiones sin credencial
# válida) y la IP de la conexión sería la del ingress, así que todos compartirían cubo. Con true se usa el valor que AGREGA
# el ingress en X-Forwarded-For (el de más a la derecha; TRAZATEX_RATE_LIMIT_TRUSTED_HOPS cuenta saltos desde la derecha,
# 1 por defecto). Desactivado por defecto: un X-Forwarded-For enviado por el cliente nunca se usa.
# TRAZATEX_RATE_LIMIT_TRUST_FORWARDED_FOR=false
# TRAZATEX_RATE_LIMIT_TRUSTED_HOPS=1
# Los de los demás servicios, mismo patrón; el Gateway los usa cuando agrega su ruta (fases 04 y 05, siguiente sprint).
PRODUCTION_URL=http://localhost:8082
TRACEABILITY_URL=http://localhost:8084
# [SIGUIENTE SPRINT]
QUALITY_URL=http://localhost:8083
NOTIFICATION_URL=http://localhost:8085
ANALYTICS_URL=http://localhost:8086


# -----------------------------------------------------------------------------
# 3. organization-access (puerto 8081, base orgaccess_db)
# -----------------------------------------------------------------------------

# Base de datos propia. Equivalen a DB_URL, DB_USER, DB_PASSWORD del servicio.
ORGACCESS_DB_URL=jdbc:postgresql://localhost:5432/orgaccess_db
ORGACCESS_DB_USER=
ORGACCESS_DB_PASSWORD=

# Par de claves RSA 2048 con el que emite los JWT RS256 (Identity Provider). La pública se publica
# en /.well-known/jwks.json. Formato: el PEM completo codificado en Base64, en una sola línea (sin
# saltos de línea): JWT_PRIVATE_KEY = PEM PKCS#8 privado, JWT_PUBLIC_KEY = PEM X.509 público.
# No las escribas a mano: `infra/scripts/generate-jwt-keys.sh` genera el par y lo escribe en tu
# .env (se niega a pisar un par existente; `--force` lo reemplaza e invalida los JWT emitidos).
# Nunca van en el repositorio.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Identificador (`kid`) de este par. Va en la cabecera de cada JWT y en el JWKS, para que el Gateway
# sepa con qué clave validar. Al rotar el par se cambia el `kid`. El script lo genera.
JWT_KEY_ID=

# URL base del frontend: el enlace de aceptación de una invitación es <esta URL>/invitations/<token>
# (va en InvitationCreated.acceptUrl).
TRAZATEX_FRONTEND_URL=http://localhost:5173

# Token (Bearer) de la API de Chequea.pe para validar el RUC (ADR-012). Sin él no se acepta
# ningún RUC que no esté ya en la caché de validaciones: nunca se acepta un RUC sin validar.
CHEQUEA_API_TOKEN=

# Activa la comprobación de contraseñas filtradas con Have I Been Pwned (ADR-007, k-anonymity).
# Si el servicio externo cae, se acepta con una advertencia auditada.
# Con `false` no se consulta nada (ni se audita).
HIBP_ENABLED=true

# Bootstrap del Dueño de Licencia (ADR-013): al iniciar, si no existe licencia, se crea con estos
# datos y se invita al dueño. No hay contraseña por defecto. Todas obligatorias.
# Correo del Dueño de Licencia (recibe la invitación).
TRAZATEX_OWNER_EMAIL=
# Nombre completo del Dueño de Licencia.
TRAZATEX_OWNER_NAME=
# Máximo de empresas que permite la licencia.
TRAZATEX_LICENSE_MAX_COMPANIES=
# Máximo de usuarios por empresa que permite la licencia.
TRAZATEX_LICENSE_MAX_USERS_PER_COMPANY=


# -----------------------------------------------------------------------------
# 4. production (puerto 8082, base production_db)
# -----------------------------------------------------------------------------

# Base de datos propia. Equivalen a DB_URL, DB_USER, DB_PASSWORD del servicio.
PRODUCTION_DB_URL=jdbc:postgresql://localhost:5432/production_db
PRODUCTION_DB_USER=
PRODUCTION_DB_PASSWORD=

# Rendimiento mínimo (salida total / entrada total, en %) que exige cada tipo de transformación (docs/domain/production.md).
# Opcionales: se muestran con su valor por defecto. Un valor fuera de (0, 100] impide arrancar el servicio.
# TRAZATEX_TRANSFORMATION_MIN_YIELD_SPINNING=60
# TRAZATEX_TRANSFORMATION_MIN_YIELD_WEAVING=80
# TRAZATEX_TRANSFORMATION_MIN_YIELD_DYEING=80

# Credencial de Cloudinary para las imágenes (ADR-007): cloudinary://<api_key>:<api_secret>@<cloud_name>.
# Si cae, o si está vacía, las evidencias se aceptan igual y quedan PENDING en una cola local (PostgreSQL) hasta que se pueda subir:
# production arranca con un WARN y un valor mal formado impide arrancar (sin imprimir el secreto). También la usará quality.
CLOUDINARY_URL=


# -----------------------------------------------------------------------------
# 5. traceability (puerto 8084, Neo4j)
# -----------------------------------------------------------------------------

# Conexión a Neo4j por bolt. Usuario y contraseña son los de la sección 1.
NEO4J_URI=bolt://localhost:7687
# (NEO4J_USER y NEO4J_PASSWORD: ver sección 1.)


# =============================================================================
# [SIGUIENTE SPRINT] — Quality, Notification y Analytics. Aún no se implementan.
# Se dejan listas porque docker compose ya crea sus bases con estos usuarios.
# =============================================================================

# --- quality (puerto 8083, base quality_db) ----------------------------------
QUALITY_DB_URL=jdbc:postgresql://localhost:5432/quality_db
QUALITY_DB_USER=
QUALITY_DB_PASSWORD=
# (CLOUDINARY_URL: la misma de la sección 4.)

# URL base de production para el comando interno Quality -> Production
# (POST /internal/batches/{batchId}/phase-transitions, ADR-009). Solo red interna.
PRODUCTION_INTERNAL_URL=http://localhost:8082

# --- notification (puerto 8085, base notification_db) ------------------------
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db
NOTIFICATION_DB_USER=
NOTIFICATION_DB_PASSWORD=

# Clave de la API de SendGrid para los correos (ADR-007). Si cae, los correos quedan en una
# tabla de diferidos con un job de reenvío.
SENDGRID_API_KEY=

# --- analytics (puerto 8086, base analytics_db) ------------------------------
ANALYTICS_DB_URL=jdbc:postgresql://localhost:5432/analytics_db
ANALYTICS_DB_USER=
ANALYTICS_DB_PASSWORD=
